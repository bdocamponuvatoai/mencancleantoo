# Public origin of the site, used for canonical URLs, Open Graph, robots.txt and sitemap.xml.
# On Vercel this falls back to https://$VERCEL_PROJECT_PRODUCTION_URL; locally to http://localhost:3000.
SITE_URL=https://www.example.com

# Set to "true" only after the owner approves the public launch. Anything else keeps
# <meta name="robots" content="noindex, nofollow"> and a robots.txt that disallows all crawling.
# The build fails if this is "true" while SITE_URL is still localhost.
SITE_INDEXABLE=false
